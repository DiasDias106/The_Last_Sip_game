  m_Script: {fileID: 11500000, guid: 68e19cf2c0a105c40a281f82d309ec86, type: 3}
  m_Name: Dialogo_Morreu
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - textEN: You lost yesterday's battle, but today is a new day. Clear your mind.
    textPT: "Perdeste a batalha de ontem, mas hoje \xE9 um novo dia. Limpa a mente."
    audioClip: {fileID: 8300000, guid: bc41f5cdbe10ad94ca7b0b50ef37b02f, type: 3}
  - textEN: The weight you feel isn't your armor. It's the past. Let it go.
    textPT: "O peso que sentes n\xE3o \xE9 da tua armadura. \xC9 do passado. Larga-o."
    audioClip: {fileID: 8300000, guid: 4cc420c583f808445a613f3b8ef6f34a, type: 3}
  - textEN: 'Remember: you are stronger than the thirst.'
    textPT: "Lembra-te: tu \xE9s mais forte do que a sede."
    audioClip: {fileID: 8300000, guid: 1f61e34e14f63e4478e273ea81d958bb, type: 3}
  playRandomLine: 1
