using System;
using System.Collections;
using TMPro;
using UnityEngine;
using UnityEngine.UI;
#if ENABLE_INPUT_SYSTEM
using UnityEngine.InputSystem;
using UnityEngine.InputSystem.Controls;
#endif

public sealed class StartupSplashController : MonoBehaviour
{
    [Header("References")]
    [SerializeField] private GameObject splashPanel;
    [SerializeField] private GameObject mainMenuPanel;
    [SerializeField] private CanvasGroup splashCanvasGroup;
    [SerializeField] private CanvasGroup promptCanvasGroup;
    [SerializeField] private Image splashArtworkImage;
    [SerializeField] private TMP_Text promptText;

    [Header("Sequence")]
    [SerializeField] private bool playOnlyOncePerSession = true;
    [SerializeField] private float initialDelay = 0.15f;
    [SerializeField] private float fadeInDuration = 1.05f;
    [SerializeField] private float promptRevealDuration = 0.35f;
    [SerializeField] private float fadeOutDuration = 0.4f;
    [SerializeField] private float promptPulseSpeed = 1.1f;
    [SerializeField] private string promptMessage = "CLIQUE EM QUALQUER TELA PARA COMECAR";

    public event Action SequenceFinished;

    private static bool hasPlayedThisSession;

    private Coroutine activeSequence;
    private bool waitingForInput;

    private void Awake()
    {
        ApplyPromptMessage();
        HideImmediate(true);
    }

    private void Update()
    {
        if (!waitingForInput || promptCanvasGroup == null)
        {
            return;
        }

        float pulse = 0.55f + 0.45f * (0.5f + 0.5f * Mathf.Sin(Time.unscaledTime * promptPulseSpeed * Mathf.PI * 2f));
        promptCanvasGroup.alpha = pulse;
    }

    public void PrepareForIntro()
    {
        ApplyPromptMessage();
        waitingForInput = false;

        if (mainMenuPanel != null)
        {
            mainMenuPanel.SetActive(false);
        }

        if (splashPanel != null)
        {
            splashPanel.SetActive(true);
        }

        if (splashCanvasGroup != null)
        {
            splashCanvasGroup.alpha = 0f;
            splashCanvasGroup.interactable = true;
            splashCanvasGroup.blocksRaycasts = true;
        }

        if (promptCanvasGroup != null)
        {
            promptCanvasGroup.alpha = 0f;
            promptCanvasGroup.interactable = false;
            promptCanvasGroup.blocksRaycasts = false;
        }

        if (splashArtworkImage != null)
        {
            splashArtworkImage.preserveAspect = true;
        }
    }

    public void BeginIntro()
    {
        if (!ShouldPlayIntro())
        {
            HideImmediate(true);
            SequenceFinished?.Invoke();
            return;
        }

        if (activeSequence != null)
        {
            StopCoroutine(activeSequence);
        }

        PrepareForIntro();
        activeSequence = StartCoroutine(PlayIntroRoutine());
    }

    public void HideImmediate(bool revealMainMenu)
    {
        if (activeSequence != null)
        {
            StopCoroutine(activeSequence);
            activeSequence = null;
        }

        waitingForInput = false;

        if (splashCanvasGroup != null)
        {
            splashCanvasGroup.alpha = 0f;
            splashCanvasGroup.interactable = false;
            splashCanvasGroup.blocksRaycasts = false;
        }

        if (promptCanvasGroup != null)
        {
            promptCanvasGroup.alpha = 0f;
            promptCanvasGroup.interactable = false;
            promptCanvasGroup.blocksRaycasts = false;
        }

        if (splashPanel != null)
        {
            splashPanel.SetActive(false);
        }

        if (mainMenuPanel != null)
        {
            mainMenuPanel.SetActive(revealMainMenu);
        }
    }

    private IEnumerator PlayIntroRoutine()
    {
        if (initialDelay > 0f)
        {
            yield return new WaitForSecondsRealtime(initialDelay);
        }

        yield return FadeCanvasGroup(splashCanvasGroup, 0f, 1f, fadeInDuration);
        yield return FadeCanvasGroup(promptCanvasGroup, 0f, 1f, promptRevealDuration);

        waitingForInput = true;
        while (!WasStartRequestedThisFrame())
        {
            yield return null;
        }

        waitingForInput = false;
        yield return FadeCanvasGroup(splashCanvasGroup, splashCanvasGroup != null ? splashCanvasGroup.alpha : 1f, 0f, fadeOutDuration);

        hasPlayedThisSession = true;
        HideImmediate(true);
        activeSequence = null;
        SequenceFinished?.Invoke();
    }

    private IEnumerator FadeCanvasGroup(CanvasGroup target, float from, float to, float duration)
    {
        if (target == null)
        {
            yield break;
        }

        if (duration <= 0f)
        {
            target.alpha = to;
            yield break;
        }

        float elapsed = 0f;
        target.alpha = from;
        while (elapsed < duration)
        {
            elapsed += Time.unscaledDeltaTime;
            target.alpha = Mathf.Lerp(from, to, Mathf.Clamp01(elapsed / duration));
            yield return null;
        }

        target.alpha = to;
    }

    private void ApplyPromptMessage()
    {
        if (promptText != null)
        {
            promptText.text = promptMessage;
        }
    }

    private bool ShouldPlayIntro()
    {
        return !playOnlyOncePerSession || !hasPlayedThisSession;
    }

    private static bool WasStartRequestedThisFrame()
    {
#if ENABLE_INPUT_SYSTEM
        if (Keyboard.current != null && Keyboard.current.anyKey.wasPressedThisFrame)
        {
            return true;
        }

        if (Mouse.current != null &&
            (Mouse.current.leftButton.wasPressedThisFrame ||
             Mouse.current.rightButton.wasPressedThisFrame ||
             Mouse.current.middleButton.wasPressedThisFrame))
        {
            return true;
        }

        if (Gamepad.current != null &&
            (Gamepad.current.buttonSouth.wasPressedThisFrame ||
             Gamepad.current.startButton.wasPressedThisFrame))
        {
            return true;
        }

        if (Touchscreen.current != null)
        {
            foreach (TouchControl touch in Touchscreen.current.touches)
            {
                if (touch.press.wasPressedThisFrame)
                {
                    return true;
                }
            }
        }

        return false;
#else
        return Input.anyKeyDown || Input.GetMouseButtonDown(0) || Input.GetMouseButtonDown(1);
#endif
    }
}
