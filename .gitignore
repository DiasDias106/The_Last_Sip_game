# ===========================
# UNITY - .gitignore
# ===========================

# Pastas geradas pelo Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Ficheiros de cache do Unity
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Asset meta data desnecessários
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider cache
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebug[Hh]yphen*/
[Rr]elease/
[Rr]eleasePublic/
[Rr]elease[Hh]yphen*/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options
.vs/

# Ficheiros de solução do Visual Studio
*.sln
*.csproj

# Rider
.idea/

# Mono develop
*.userprefs

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Profiling
[Pp]rofile[Rr]eport*/

# ===========================
# GIT
# ===========================

# Ficheiros de merge
*.orig

# ===========================
# SISTEMA OPERATIVO
# ===========================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ===========================
# OUTROS
# ===========================

# Backup files
*.bak
*.backup
*.tmp

# Logs
*.log

# Node (caso uses ferramentas JS)
node_modules/
npm-debug.log*

# Dotenv
.env
.env.local.mcp.json
